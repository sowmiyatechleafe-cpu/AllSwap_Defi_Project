# Copy this file to frontend/.env.local after deploying the contracts.
VITE_PILOT_TOKEN_ADDRESS=
VITE_USDC_TOKEN_ADDRESS=
VITE_SWAP_CONTRACT_ADDRESS=

# Optional mock tokens (leave empty to show "Not configured")
VITE_WBTC_TOKEN_ADDRESS=
VITE_DAI_TOKEN_ADDRESS=
VITE_LINK_TOKEN_ADDRESS=
VITE_UNI_TOKEN_ADDRESS=
VITE_USDT_TOKEN_ADDRESS=

# Optional: how often live prices refresh, in ms (default 30000, minimum 10000)
# VITE_PRICE_REFRESH_MS=30000

# Optional: how often live prices refresh, in ms (default 30000, minimum 10000)
# VITE_PRICE_REFRESH_MS=30000

# Optional: Solana RPC used to read the SOL balance (default: public mainnet-beta)
# VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
